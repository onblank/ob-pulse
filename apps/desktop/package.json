{
  "name": "@obpulse/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "author": "onBlank Systems",
  "homepage": "https://github.com/onblank/ob-pulse",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win",
    "package:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@obpulse/contracts": "workspace:*",
    "@obpulse/application": "workspace:*",
    "@obpulse/host-metrics": "workspace:*",
    "@obpulse/instrumentation-http": "workspace:*",
    "@obpulse/runtime-ollama": "workspace:*",
    "@obpulse/runtime-lmstudio": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.0"
  }
}
